{
  "name": "percolator-cli",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./normalized": "./dist/normalized/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "smoke": "tsx scripts/smoke-v16-bounty5.ts",
    "test": "pnpm test:offline",
    "test:devnet": "node --import tsx tests/v16/devnet-smoke.ts",
    "test:offline": "pnpm test:mukon-compat && pnpm test:normalized",
    "test:legacy-manifest": "node --import tsx scripts/verify-manifest.ts",
    "test:mukon-compat": "node --import tsx scripts/mukon-deployed-v16.test.ts",
    "test:normalized": "node --import tsx tests/normalized/foundation.test.ts"
  },
  "dependencies": {
    "@pythnetwork/hermes-client": "^2.1.0",
    "@pythnetwork/pyth-solana-receiver": "^0.13.0",
    "@solana/spl-token": "^0.3.11",
    "@solana/web3.js": "^1.95.4",
    "@switchboard-xyz/on-demand": "^3.10.1",
    "bs58": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "dotenv": "^17.2.4",
    "tsup": "^8.3.5",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
